# Copy this file to .env and adjust as needed. All values are optional; sensible defaults are used if omitted.

# Port the API server listens on.
PORT=4000

# Path to the SQLite database file. Defaults to ./data/chemlab.db.
# DATABASE_FILE=./data/chemlab.db

# Origin allowed to make cross-origin requests (the frontend dev server).
CORS_ORIGIN=http://localhost:5173

# Optional: set this to upgrade the AI assistant's natural-language understanding
# from the built-in rule-based parser to a real Claude call. Not required --
# the app is fully functional without it. Get a key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=
